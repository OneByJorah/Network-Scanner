# Flask Backend Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-string
DATABASE_URL=sqlite:///network_scanner.db

# PostgreSQL (optional - uncomment to use instead of SQLite)
# DATABASE_URL=postgresql://network_scanner:network_scanner_password@postgres:5432/network_scanner

# OpenAI (optional - required for AI features)
OPENAI_API_KEY=

# Redis (for Celery background tasks)
REDIS_URL=redis://redis:6379

# Security
CORS_ORIGINS=http://localhost:3000

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# Frontend
FRONTEND_PORT=3000
